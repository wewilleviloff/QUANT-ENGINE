{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/contracts/v1/order-command.schema.json",
  "title": "OrderCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "signal_id", "symbol", "side", "quantity", "order_type", "reduce_only", "mode"],
  "properties": {
    "command_id": { "type": "string", "format": "uuid" },
    "signal_id": { "type": "string", "format": "uuid" },
    "symbol": { "type": "string" },
    "side": { "enum": ["Buy", "Sell"] },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "order_type": { "enum": ["Market", "Limit"] },
    "price": { "type": ["string", "null"] },
    "reduce_only": { "type": "boolean" },
    "mode": { "const": "paper" }
  }
}
