{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-engine.local/contracts/v1/risk-decision.schema.json",
  "title": "RiskDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "signal_id", "approved", "reason_codes", "created_at"],
  "properties": {
    "decision_id": { "type": "string", "format": "uuid" },
    "signal_id": { "type": "string", "format": "uuid" },
    "approved": { "type": "boolean" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "notional": { "type": ["string", "null"] },
    "margin": { "type": ["string", "null"] },
    "leverage": { "type": ["string", "null"] },
    "estimated_loss_at_stop": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
